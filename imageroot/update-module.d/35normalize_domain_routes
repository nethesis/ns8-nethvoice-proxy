# Save legacy mixed-case domain routes in lowercase, so requests match them
# in any casing without waiting for NethVoice to save the route again.
# Kamailio loads the tables when 40reconfigure restarts it.

import os
import subprocess
import sys

from domain_routes import run_route_query

result = subprocess.run(
    [
        'podman', 'exec', '-i', 'postgres', 'psql', '-X', '-qAt', '-v', 'ON_ERROR_STOP=1',
        '-U', os.environ['POSTGRES_USER'], os.environ['POSTGRES_DB'],
    ],
    input="SELECT target FROM nethvoice_proxy_routes WHERE route_type = 'domain' AND target <> lower(target);",
    text=True, stdout=subprocess.PIPE, check=True,
)

for target in result.stdout.splitlines():
    try:
        run_route_query(target, """
UPDATE nethvoice_proxy_routes SET target = :'domain' WHERE id = (SELECT id FROM selected_route);
UPDATE domain SET domain = :'domain', did = :'domain' WHERE lower(domain) = :'domain';
UPDATE dialplan SET match_exp = :'domain' WHERE dpid = 1 AND lower(match_exp) = :'domain';
""")
        print(f"Normalized SIP domain route {target}", file=sys.stderr)
    except subprocess.CalledProcessError:
        # Ambiguous or inconsistent records need a manual fix: keep them as they are.
        print(f"Skipped SIP domain route {target}: records are ambiguous or inconsistent", file=sys.stderr)
