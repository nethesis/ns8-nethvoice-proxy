import argparse
import os

import agent
import yaml


RULE_SETS = ("systemd-exporter", "core-services")
CORE_SERVICES = (
    ("kamailio", "Kamailio"),
    ("rtpengine", "RTPengine"),
    ("postgres", "PostgreSQL"),
    ("redis", "Redis"),
)


def service_rule(service, component):
    unit = f"{service}.service"
    return {
        "alert": f"NethVoiceProxy{component}Down",
        "expr": (
            '(up{target_type="systemd"} == 1) unless on(instance, module_id) '
            '(systemd_unit_state{target_type="systemd", '
            f'name="{unit}", state="active"}} == 1)'
        ),
        "for": "5m",
        "labels": {"severity": "critical", "service": unit},
        "annotations": {
            "summary_en": f"NethVoice Proxy service {unit} is unavailable",
            "summary_it": f"Servizio NethVoice Proxy {unit} non disponibile",
            "description_en": (
                f"The expected unit {unit} has been inactive or missing for 5 minutes "
                "on {{ $labels.module_id }} (node {{ $labels.node }}). "
                "The systemd exporter is reachable."
            ),
            "description_it": (
                f"L'unità attesa {unit} è inattiva o assente da 5 minuti "
                "su {{ $labels.module_id }} (nodo {{ $labels.node }}). "
                "L'esportatore systemd è raggiungibile."
            ),
        },
    }


def exporter_rule():
    return {
        "alert": "NethVoiceProxySystemdExporterDown",
        "expr": 'up{target_type="systemd"} == 0',
        "for": "5m",
        "labels": {"severity": "critical", "service": "systemd-exporter.service"},
        "annotations": {
            "summary_en": "NethVoice Proxy service monitoring is unavailable",
            "summary_it": "Monitoraggio dei servizi NethVoice Proxy non disponibile",
            "description_en": (
                "The systemd exporter for {{ $labels.module_id }} "
                "(node {{ $labels.node }}) has been unreachable for 5 minutes. "
                "Service states cannot be monitored."
            ),
            "description_it": (
                "L'esportatore systemd di {{ $labels.module_id }} "
                "(nodo {{ $labels.node }}) non è raggiungibile da 5 minuti. "
                "Impossibile monitorare lo stato dei servizi."
            ),
        },
    }


def rule_document(name, rules):
    return yaml.safe_dump(
        {"groups": [{"name": f"nethvoice-proxy.{name}", "rules": rules}]},
        allow_unicode=True,
        sort_keys=False,
    )


def build_rule_sets(env):
    # Both values are needed to publish a usable systemd scrape target.
    if not (env.get("NETHVOICE_PROXY_SYSTEMD_EXPORTER_PORT")
            and env.get("SYSTEMD_EXPORTER_PROMETHEUS_PATH")):
        return {}
    # All four application services start during installation, before FQDN setup.
    return {
        "systemd-exporter": rule_document("systemd-exporter", [exporter_rule()]),
        "core-services": rule_document(
            "core-services", [service_rule(*service) for service in CORE_SERVICES],
        ),
    }


def publish_rules(remove=False):
    # Runtime identity belongs to the destination instance after restore/clone.
    key = f'module/{os.environ["MODULE_ID"]}/metrics_alert_rules'
    channel = f'{os.environ["AGENT_ID"]}/event/metrics-alert-rules-changed'
    desired = {} if remove else build_rule_sets(agent.read_envfile("environment"))
    with agent.redis_connect(privileged=True) as rdb:
        previous = {
            name: value.decode() if isinstance(value, bytes) else value
            for name, value in zip(RULE_SETS, rdb.hmget(key, RULE_SETS))
            if value is not None
        }
        if desired == previous:
            return
        trx = rdb.pipeline(transaction=True)
        for name, value in desired.items():
            if previous.get(name) != value:
                trx.hset(key, name, value)
        obsolete = previous.keys() - desired.keys()
        if obsolete:
            trx.hdel(key, *sorted(obsolete))
        trx.publish(channel, "{}")
        trx.execute()


def main():
    parser = argparse.ArgumentParser(description="Publish NethVoice Proxy service alert rules")
    parser.add_argument("command", choices=("update", "remove"))
    args = parser.parse_args()
    publish_rules(remove=args.command == "remove")


if __name__ == "__main__":
    main()
