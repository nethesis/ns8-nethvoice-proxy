import json
import os
import sys

import agent
import sip_ports

agent.set_weight(os.path.basename(__file__), 0) # Validation step, no task progress at all

data = json.load(sys.stdin)

current_sip_port, current_sips_port = sip_ports.get_ports()
sip_port = data.get("sip_port", current_sip_port)
sips_port = data.get("sips_port", current_sips_port)

errors = sip_ports.validate_ports(sip_port, sips_port)
if errors:
    agent.set_status('validation-failed')
    json.dump([{'field': field, 'parameter': field, 'value': sip_port if field == 'sip_port' else sips_port, 'error': error} for field, error in errors], fp=sys.stdout)
    sys.exit(3)
