import json
import sys
import agent
import subprocess
import os
import sip_ports

data = json.load(sys.stdin)

local_networks = set()

# SIP ports: from the input, otherwise the current ones. The previous ports
# are needed to remove the rules created with them, so they are saved only
# after the firewall changes succeed: a retry removes the same rules.
prev_sip_port, prev_sips_port = sip_ports.get_ports()
sip_port = data.get("sip_port", prev_sip_port)
sips_port = data.get("sips_port", prev_sips_port)

def set_public_firewall_ports(behind_nat):
    agent.assert_exp(agent.add_public_service(
        os.environ["MODULE_ID"],
        sip_ports.public_ports(sip_port, sips_port, behind_nat),
        replace_ports=True,
    ))

def replace_port_forward_rules(previous_rules, new_rules):
    """Replace the port forwarding rules of the local networks and check the
    firewall configuration: the node actions do not report the failure of a
    single rule."""
    stale_rules = [rule for rule in previous_rules if rule not in new_rules]
    if stale_rules:
        agent.assert_exp(agent.remove_rich_rules(stale_rules), "Failed to remove the port forwarding rules")
    if new_rules:
        agent.assert_exp(agent.add_rich_rules(new_rules), "Failed to add the port forwarding rules")
    if stale_rules or new_rules:
        current_rules = {sip_ports.rule_key(rule) for rule in agent.list_rich_rules(raise_on_error=True)}
        agent.assert_exp(not any(sip_ports.rule_key(rule) in current_rules for rule in stale_rules), "Some port forwarding rules were not removed")
        agent.assert_exp(all(sip_ports.rule_key(rule) in current_rules for rule in new_rules), "Some port forwarding rules were not added")

if "addresses" in data:

    address = data["addresses"]
    # With a public address the proxy is behind NAT
    behind_nat = "public_address" in address

    if behind_nat:
        # Get local network from routing table (excluding default route)
        detected_network = os.popen("ip route | grep -v default | grep 'src " + address["address"] + "' | awk '{print $1}'").read().strip()
        if detected_network:
            local_networks.add(detected_network)

        # Check if local_networks field is present in data
        if "local_networks" in data and data["local_networks"]:
            # Add extra local networks
            local_networks.update(set(data["local_networks"]))

    # Port forwarding rules of the previous configuration and of the new one
    previous_rules = []
    prev_localnetworks = os.environ.get("LOCALNETWORKS")
    prev_private_ip = os.environ.get("PRIVATE_IP")
    if prev_localnetworks and prev_private_ip:
        prev_networks = [n for n in prev_localnetworks.split(",") if n]
        previous_rules = sip_ports.port_forward_rules(prev_networks, prev_sip_port, prev_sips_port)
    new_rules = sip_ports.port_forward_rules(list(local_networks), sip_port, sips_port)

    replace_port_forward_rules(previous_rules, new_rules)
    set_public_firewall_ports(bool(local_networks))

    # Save the addresses only after the firewall changes succeed: a retry
    # derives the rules to remove from them
    if behind_nat:
        agent.set_env("PUBLIC_IP", address["public_address"])
        agent.set_env("PRIVATE_IP", address["address"])
        agent.set_env("BEHIND_NAT", "true")
        if local_networks:
            agent.set_env("LOCALNETWORKS", ",".join(local_networks))
    else:
        agent.set_env("PUBLIC_IP", address["address"])
        agent.set_env("PRIVATE_IP", "")
        agent.set_env("BEHIND_NAT", "false")
        agent.unset_env("LOCALNETWORKS")

    agent.set_env("DEFAULT_CONTACT", (address["address"] if "public_address" not in address else address["public_address"]) + f":{sip_port}")

agent.set_env("SIP_PORT", str(sip_port))
agent.set_env("SIPS_PORT", str(sips_port))

# Log level kamailio is started with. The field is optional: when it is not
# part of the input, keep the value already stored in the environment, so that
# a level set from the CLI is not reset by a save from the settings page.
# 0 (warning) is the default of the module.
if "kamailio_log_level" in data:
    agent.set_env("KAMAILIO_LOG_LEVEL", str(data["kamailio_log_level"]))
elif not os.environ.get("KAMAILIO_LOG_LEVEL"):
    agent.set_env("KAMAILIO_LOG_LEVEL", "0")

# Built-in alerts. Optional: when it is not part of the input, keep
# the stored value. The rules are published by a later step.
if "alerts_enabled" in data:
    agent.set_env("ALERTS_ENABLED", "true" if data["alerts_enabled"] else "false")

if "service_net" in data:
    service = data["service_net"]
    agent.set_env("SERVICE_IP", service["address"])
    agent.set_env("SERVICE_NET", service["netmask"])
