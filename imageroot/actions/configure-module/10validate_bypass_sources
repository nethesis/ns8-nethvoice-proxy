import json
import os
import sys

import agent
import proxy_bypass

agent.set_weight(os.path.basename(__file__), 0) # Validation step, no task progress at all

data = json.load(sys.stdin)

sources = data.get("bypass_sources")
if not sources:
    sys.exit(0)

errors = proxy_bypass.validate_sources(
    sources,
    proxy_bypass.local_instance_ports(),
    proxy_bypass.parse_sources(os.environ.get("BYPASS_SOURCES")),
)
if errors:
    agent.set_status('validation-failed')
    json.dump([{'field': 'bypass_sources', 'parameter': 'bypass_sources', 'value': value, 'error': error} for value, error in errors], fp=sys.stdout)
    sys.exit(3)
