import os
import agent
import sip_ports

# Open SIP (TCP/UDP), SIPS (TCP only) and RTP range (10000-20000).
# NAT-only ports 6060/6061 are managed during configure-module.
agent.assert_exp(agent.add_public_service(os.environ['MODULE_ID'],
    sip_ports.public_ports(*sip_ports.get_ports())))
