# Publish the module alert rules for the metrics module, or remove them
# while ALERTS_ENABLED is not "true". Also linked from configure-module, to
# apply the alerts_enabled field, and from update-module.d, to publish the
# rules of a new image. A failure must not stop the module creation,
# configuration or update.

exec 1>&2

if ! publish-metrics-config; then
    echo "Warning: alert rules not published"
fi
